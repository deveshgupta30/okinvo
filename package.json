{
  "name": "okinvo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "design:tokens": "tsx scripts/design-tokens.ts",
    "design:lint": "node scripts/design-lint.mjs",
    "db:up": "docker compose -f compose.dev.yml up -d --wait postgres",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:check": "node scripts/db-check.mjs",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "archiver": "8.0.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-stringify": "6.9.0",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.5",
    "exceljs": "4.4.0",
    "file-type": "22.1.1",
    "lucide-react": "1.49.0",
    "nanoid": "6.0.1",
    "next": "16.3.8",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/archiver": "8.0.0",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "pdf-parse": "2.4.5",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
