    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx",
        "GHSA-3f6p-5ww8-9rcr"
      ]
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
