{$APP_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 25MB
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    reverse_proxy app:3000 {
        header_up X-Forwarded-Proto {scheme}
    }
    log {
        output file /data/access.log {
            roll_size 10MiB
            roll_keep 5
        }
    }
}

# Documentation site (compose profile `docs`): Wiki.js on its own host. Set DOCS_DOMAIN in .env to
# a name that resolves to this machine (docs.<your domain>); without the profile the host answers 502.
{$DOCS_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    reverse_proxy wiki:3000 {
        header_up X-Forwarded-Proto {scheme}
    }
}
