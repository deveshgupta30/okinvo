# ── App ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000            # public origin; in production https://invoices.example.com
APP_DOMAIN=localhost                     # Caddy site address (compose only)
NODE_ENV=development                     # compose sets production itself
LOG_LEVEL=info
TRUST_PROXY=false                        # compose sets true itself; set true behind any other ingress

# ── Database ─────────────────────────────────────────────────────────
# POSTGRES_* feed the compose Postgres and compose derives the container DATABASE_URL from them.
# DATABASE_URL below is for `pnpm dev`, the Prisma CLI and tests on this machine (compose.dev.yml).
POSTGRES_USER=okinvo
POSTGRES_PASSWORD=okinvo
POSTGRES_DB=okinvo
DATABASE_URL=postgresql://okinvo:okinvo@127.0.0.1:5432/okinvo

# ── Secrets — replace with: scripts/gen-secrets.sh >> .env ───────────
# Placeholders are rejected at boot on purpose.
AUTH_SECRET=replace-me-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=replace-me-32-bytes-base64

# ── Sign-in (M1). A provider appears only when fully configured. ─────
AUTH_ALLOWED_EMAILS=                      # you@example.com,*@yourdomain.com  (required in production)
AUTH_LINKING_TRUSTED_PROVIDERS=google,github
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_KEYCLOAK_ISSUER=
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
AUTH_CASDOOR_ISSUER=
AUTH_CASDOOR_ID=
AUTH_CASDOOR_SECRET=
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
AUTH_OIDC_NAME="Enterprise SSO"

# ── Storage ──────────────────────────────────────────────────────────
STORAGE_DRIVER=local                      # local | s3
STORAGE_LOCAL_ROOT=./.data/storage        # compose sets /data/storage itself
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=okinvo
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Email (M3; optional, Settings → Email overrides) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls                    # starttls | tls | none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_REPLY_TO=

# ── Limits ───────────────────────────────────────────────────────────
RATE_LIMIT_STORE=memory                   # memory | postgres
UPLOAD_MAX_IMAGE_MB=2
UPLOAD_MAX_RECEIPT_MB=10

# ── Compose image tag ────────────────────────────────────────────────
OKINVO_VERSION=latest
