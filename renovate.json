{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies", "docker:pinDigests"],
  "schedule": ["before 6am on monday"],
  "timezone": "Asia/Kolkata",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch"], "groupName": "minor and patch updates" },
    {
      "matchPackageNames": ["node"],
      "matchDatasources": ["docker", "node-version"],
      "allowedVersions": "/^24\\./",
      "description": "Stay on the active LTS until Node 26 is LTS"
    },
    {
      "matchPackageNames": ["prisma", "@prisma/client", "@prisma/adapter-pg"],
      "groupName": "prisma",
      "allowedVersions": "<8"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7",
      "description": "typescript-eslint 8.x rejects TS 7.0 (typescript-eslint#10940); lift when it supports 7.x"
    },
    {
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10",
      "description": "eslint-config-next's eslint-plugin-react supports eslint <=9 (context.getFilename removed in 10)"
    }
  ]
}
